# Optional storage location. Relative paths are resolved from the backend working directory.
# For the local Windows test, set this to E:/vul
DATA_DIR=./data

# Optional explicit database URL. Leave blank to create/use DATA_DIR/vul_management.db.
# If set, DATABASE_URL takes precedence over DATA_DIR for the database file.
DATABASE_URL=

# Telegram API credentials: https://my.telegram.org
# Keep these credentials and the Telegram session local; never include .env or session files in a customer package.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Leave blank to use DATA_DIR/telegram automatically.
TELEGRAM_SESSION=

# Optional Jira Cloud integration. Use an API token, not your account password.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
