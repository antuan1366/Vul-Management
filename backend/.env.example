# Copy this file to backend/.env and fill only the settings you actually use.
# Never commit backend/.env or share it in a customer support ticket.

APP_NAME=Vul-Management
APP_VERSION=3.2.0

# SQLite path is relative to the backend working directory.
DATABASE_URL=sqlite:///./data/vul_management.db

# Keep disabled for customer deployments unless a controlled debug session is required.
DEBUG=false

# Optional Telegram integration. Configure using your own authorized API credentials.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=./data/telegram

# Optional Jira integration. Use a Jira API token, not an account password.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
